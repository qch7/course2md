# 服务器部署配置。复制为 deploy/.env 后填写；不要提交 .env。

# 访问域名（须已解析到服务器，Caddy 会自动申请 HTTPS 证书）
COURSE2MD_DOMAIN=course.example.com

# 数据库口令与凭证加密密钥，各生成一个随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 密钥用于加密保存课程链接中的凭证，丢失后这些数据无法解密，请妥善备份。
POSTGRES_PASSWORD=
COURSE2MD_SECRET_KEY=

# 注册：closed 由管理员在「用户」中创建账号，open 允许自行注册。第一个账号总是管理员。
COURSE2MD_REGISTRATION=closed

# 校对与内置整理使用的大模型接口（所有用户共用管理员配置的接口）
COURSE2MD_API_KEY=
COURSE2MD_LLM_BASE=https://api.deepseek.com/v1
COURSE2MD_LLM_MODEL=deepseek-chat

# 预装的来源解析插件（空格分隔的包名），构建镜像时安装
COURSE2MD_PLUGINS=

# 使用 --profile gpu 运行服务器上的计算节点时：在网页「计算服务」中生成令牌后填写
COURSE2MD_WORKER_TOKEN=
